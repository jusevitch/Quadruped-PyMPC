{
    "name": "Quadruped-PyMPC DevPod",

    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },

    "remoteUser": "vscode",

    // GPU passthrough + host networking (matches compose.yaml) and IPC=host so
    // shared-memory rendering with MuJoCo / Qt works under X11 forwarding.
    "runArgs": [
        "--gpus", "all",
        "--network=host",
        "--ipc=host"
    ],

    // X11 forwarding: bind the host X socket and Xauthority so GUI apps
    // launched inside the container display on the host.
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=${localEnv:HOME}/.Xauthority,target=/home/vscode/.Xauthority,type=bind,readonly"
    ],

    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "XAUTHORITY": "/home/vscode/.Xauthority",
        "QT_X11_NO_MITSHM": "1",
        "LIBGL_ALWAYS_SOFTWARE": "1",
        "ROS_LOCALHOST_ONLY": "0",
        "ROS_DOMAIN_ID": "0",
        "RMW_IMPLEMENTATION": "rmw_cyclonedds_cpp"
    },

    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff",
                "ms-azuretools.vscode-docker",
                "ms-iot.vscode-ros",
                "anthropic.claude-code"
            ]
        }
    },

    "postCreateCommand": "bash .devcontainer/setup.sh"
}
